# Every variable backend/core/config.py reads, in the order it reads them.
# Values shown are the defaults; omit a line to accept the default.

# --- Datastore -------------------------------------------------------------
# Required. get_db() raises ConfigError naming these if either is missing.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key
ATTACHMENT_BUCKET=rate-card-attachments

# --- LLM -------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# openai | gemini — chosen at runtime, no code change needed.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# --- Mail ------------------------------------------------------------------
# gmail | gmail_workspace | outlook
EMAIL_PROVIDER=gmail_workspace

# Email Integration (Gmail or Outlook IMAP)
IMAP_SERVER=imap.gmail.com
EMAIL_ACCOUNT=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Safe mode. When set, ALL outgoing RFQ mail goes to this address instead of the
# real vendor, and the subject is prefixed [TEST -> original@vendor]. This is the
# one valve that makes the send path testable against a live inbox — leave it set
# until you intend to mail real freight agents.
#
# KNOWN GAP: only honoured on the SMTP path. send_rfq_email() returns to the
# Outlook sender before the redirect is applied, so with EMAIL_PROVIDER=outlook
# this does nothing and real vendors receive real RFQs — while /health and
# /automation/status both report safe mode as active. Do not rely on it there.
EMAIL_REDIRECT=

# Where the nightly report is mailed. Unset = no report recipient.
REPORT_RECIPIENT=

# --- Gmail via user OAuth (preferred: no Workspace admin, no service account) ---
# Client id/secret come from an OAuth client (type: Web application) with
# http://localhost:8080/ as a registered redirect URI. Create it in a GCP project
# owned by the mailbox's own domain and set the consent screen to "Internal" —
# an External app in Testing status expires refresh tokens after 7 days.
GMAIL_MAILBOX=mailbox_owner@theirdomain.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/
# Produced by: python -m backend.scripts.authorize_gmail
GMAIL_REFRESH_TOKEN=

# --- Runtime ---------------------------------------------------------------
# Owns the background work: 4 one-shot startup jobs and 6 repeating ones
# (scan and ingest every 5 min, attachments every 2, retries every 15,
# metrics hourly, gap heal daily).
#
# Exactly ONE process in a deployment may set this to 1.
#
# The scheduler starts in the lifespan handler, so every process that runs
# lifespan gets its own copy of all ten jobs. `uvicorn --workers 3` runs lifespan
# three times and gives you three schedulers scanning the same inbox on the same
# 5-minute cadence. The atomic claim in the scan makes that *safe* — no email is
# processed twice — but the claim happens after classification, so you pay
# OpenAI three times for identical work. Same for `--reload`, which imports the
# app in the child process only, and for any separate worker or cron container.
#
# So: 1 on one instance, 0 on every other. When you outgrow that, split the
# scheduler into its own process — Phase 5 of Documentation/05-hardening-plan.md.
RUN_SCHEDULER=1

# Emails classified per scan pass.
SCAN_BATCH=50

# An RFQ job sits at status 'sending' only between reserving its row and
# recording the send outcome — seconds. Past this many minutes it is treated as
# abandoned by a crashed process, and the 15-minute recovery sweep reconciles it
# against the Sent folder. Keep it well below 15 so a live-but-slow send is
# never mistaken for a stuck one.
STALE_SENDING_MINUTES=15

# When 1, the recovery sweep may re-send an RFQ it has PROVEN never left (absent
# from the Sent folder), with no human in the loop. It never resends on
# ambiguous evidence — a failed lookup, or a provider with no Sent access, is
# always flagged send_failed for a human instead. Set 0 to make the sweep
# reconcile-and-flag only, and require POST /admin/retry-stuck-sends for any
# actual resend.
AUTO_RETRY_STUCK_SENDS=1

# Comma-separated. Restricts browsers only — it stops nothing with curl, and
# there is no auth on this API yet (BUGS.md P1-1).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# 1 = one JSON object per line, correlation ids as fields. Use in production;
# text is easier to read by eye during development.
LOG_JSON=0
# Where the rotating log goes (10 MB x 50 files). MUST be outside OneDrive or
# any other synced folder — the file is rewritten constantly and the sync client
# will upload every revision. Leave empty to use <project>/logs.
LOG_DIR=C:\ProgramData\logistics-copilot\logs
# 0 in a container: stdout is the log, the platform collects it.
LOG_TO_FILE=1

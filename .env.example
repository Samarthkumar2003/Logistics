OPENAI_API_KEY=your_openai_api_key_here

# Email Integration (Gmail or Outlook IMAP)
IMAP_SERVER=imap.gmail.com
EMAIL_ACCOUNT=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# --- Gmail via user OAuth (preferred: no Workspace admin, no service account) ---
# Client id/secret come from an OAuth client (type: Web application) with
# http://localhost:8080/ as a registered redirect URI. Create it in a GCP project
# owned by the mailbox's own domain and set the consent screen to "Internal" —
# an External app in Testing status expires refresh tokens after 7 days.
EMAIL_PROVIDER=gmail_workspace
GMAIL_MAILBOX=mailbox_owner@theirdomain.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/
# Produced by: python -m backend.scripts.authorize_gmail
GMAIL_REFRESH_TOKEN=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# 1 = one JSON object per line, correlation ids as fields. Use in production;
# text is easier to read by eye during development.
LOG_JSON=0
# Where the rotating log goes (10 MB x 50 files). MUST be outside OneDrive or
# any other synced folder — the file is rewritten constantly and the sync client
# will upload every revision. Leave empty to use <project>/logs.
LOG_DIR=C:\ProgramData\logistics-copilot\logs
# 0 in a container: stdout is the log, the platform collects it.
LOG_TO_FILE=1

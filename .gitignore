.env
venv/
__pycache__/
*.pyc
node_modules/
.next/

# Documentation/06-deploying.md has you run `npm install railway` at the repo root
# for the IaC commands, which creates these two as a side effect. Keep them out of
# the repo: the api service builds from the root with no rootDirectory set, and a
# root package.json is a Node-project signal to Railway's build detection that
# nothing here intends. Local-only tooling, so there is nothing to gain by
# committing it either.
/package.json
/package-lock.json

sitecustomize_debug.txt
service_account.json

# Logs
*.log
uvicorn.log
uvicorn_test.log
uvicorn_err.log
frontend.log

# Generated files
*.xlsx
automation_state.json
reports/
whatsapp_exports/

# Email dumps and label sets — contain real customer/vendor addresses and
# message bodies. Never commit: git history is effectively permanent.
emails_dump.json
emails_3months.json
val_set.json
my_labels.json
clean_labels.json
llm_results.json
gpt4o_eval.json
perfect_prompt.txt

# Personal documents
Samarth_Resume.pdf

# Claude
.claude/scheduled_tasks.lock
.claude/worktrees/
# OAuth PKCE state between authorize_gmail steps
.oauth_pending.json
.env.dwd-backup

# Local session ops helper (machine-specific paths); Render supervises in prod
watchdog.sh
recovery_poll.log

# DB backups (contain real customer/vendor data)
rfq_jobs_backup_*.json

# macOS Finder metadata. Appears in any directory the Finder has opened, so
# match at every depth rather than only the repo root.
.DS_Store
**/.DS_Store

# JetBrains project files. Machine-local: contains absolute paths, the SDK name
# and per-user run configurations, none of which mean anything on another
# checkout. Ignored rather than committed so it stops showing up as untracked
# noise next to files that genuinely need staging.
.idea/
